{
  "name": "trabalho-2-api-biblioteca",
  "version": "2.0.0",
  "description": "API REST de biblioteca evoluída com Prisma ORM e SQLite",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "tsx src/app.js",
    "dev": "tsx watch src/app.js",
    "test": "node --check src/app.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/node": "^24.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
